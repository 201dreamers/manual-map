# Mapbox Public Access Token (starts with pk.)
# Copy this file to .env.local and insert your actual token there:
# VITE_MAPBOX_ACCESS_TOKEN=pk.your_token_here
VITE_MAPBOX_ACCESS_TOKEN=

# TomTom API key for the traffic-incidents overlay (accidents, closures, road works).
# Optional: with no key the incident layer is simply not offered and the rest of the
# app is unaffected. Free tier is 2500 requests/day.
# NOTE: this is inlined into the built bundle exactly like the Mapbox token, so it is
# public. Restrict it by referrer in the TomTom console before deploying anywhere.
VITE_TOMTOM_API_KEY=
