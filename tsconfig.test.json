{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* The layout suite imports .tsx components to render them headlessly. */
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
    `src/vite-env.d.ts` carries the ambient `__APP_BUILD__` declaration. Ambient .d.ts
    files are not pulled in transitively through imports the way modules are, so the
    suite that renders Settings needs it named here explicitly.
  */
  "include": ["tests", "scripts", "src/vite-env.d.ts"]
}
